# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# keys / certs
*.pem
*.key
*.p12
*.pfx
*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and local MCP configs (never commit real values or project refs)
.env*
!.env.example
.mcp.json
.mcp.json.*
!.mcp.json.example
.cursor/mcp.json

# KEK / mounted secrets
.kek
*.kek
/run/secrets/
financeiro_kek
financeiro_kek_*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# financial exports, statements, DB backups (real user data)
/exports/
/statements/
/backups/
/dumps/
*.dump
*.sql.gz
*.bak

# bank files dropped in the repo root / data dirs
/*.csv
/*.ofx
/*.ofc
/*.qif
/*.xlsx
/*.xls
/*.pdf
/data/
