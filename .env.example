DATABASE_URL=postgres://user:password@localhost:5432/financeiro
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=https://financeiro.example.com
NEXT_PUBLIC_SITE_URL=https://financeiro.example.com
STORAGE_DIR=/data/statements
# Optional. Enables forgot/reset password emails via Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Financeiro <noreply@example.com>
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=
PLUGGY_SYNC_USER_ID=
PLUGGY_TXN_DATE_FROM=
PLUGGY_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
CRON_SECRET=
# Build identity shown in Configurações and <meta name="app-version">.
# Coolify sets SOURCE_COMMIT. APP_ENV: homologação | produção | local
# SOURCE_COMMIT=
# NEXT_PUBLIC_COMMIT_SHA=
# APP_ENV=homologação
# NEXT_PUBLIC_APP_ENV=homologação
